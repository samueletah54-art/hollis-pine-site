# Stripe Checkout. Without a secret key the site runs in demo mode (no payment taken).
STRIPE_SECRET_KEY=
# Used for success/cancel redirects and sitemap/OG URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Quote form + newsletter. Without a Resend key, submissions are logged to the server console.
RESEND_API_KEY=
QUOTE_TO_EMAIL=orders@hollisandpine.example
QUOTE_FROM_EMAIL=Hollis & Pine <web@hollisandpine.example>
