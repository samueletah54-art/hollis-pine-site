# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # your real domain once connected

# ── Business details (shown on the site). Leave blank to use the placeholders in data/business.ts ──
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=          # lines separated by "|", e.g. 12 Mill Rd|Boone, NC 28607
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_ORDER_BY=         # e.g. December 12

# ── Payments. Without a key checkout is a demo and takes no payment. sk_test_... = test mode ──
STRIPE_SECRET_KEY=
STRIPE_AUTOMATIC_TAX=         # set to 1 once Stripe Tax is configured

# ── Email (https://resend.com). Without a key, form messages are only written to the server log ──
RESEND_API_KEY=
QUOTE_TO_EMAIL=               # where the team receives quotes and messages
QUOTE_FROM_EMAIL=             # e.g. Hollis & Pine <orders@yourdomain.com> (domain verified in Resend)
RESEND_AUDIENCE_ID=           # optional: newsletter signups go into this Resend audience

# ── Black Friday offer (defaults: 15% off live and artificial trees, Nov 27 to Nov 30, Eastern time) ──
NEXT_PUBLIC_PROMO_PERCENT=    # 0 turns the offer off
NEXT_PUBLIC_PROMO_START=      # first day, e.g. 2026-11-27
NEXT_PUBLIC_PROMO_END=        # last day, e.g. 2026-11-30

# ── Reviews ──
NEXT_PUBLIC_SAMPLE_REVIEWS=   # leave empty. "1" shows INVENTED sample reviews: private previews only
